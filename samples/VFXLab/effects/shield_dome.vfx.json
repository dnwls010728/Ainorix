{
  "format": "oe.vfx",
  "version": 1,
  "name": "Shield Dome",
  "description": "Phase 5b+ text-only acceptance proof; no gameplay transform script.",
  "budget": {
    "maxParticles": 1
  },
  "emitters": [
    {
      "name": "shield",
      "emitter": {
        "burst": 1,
        "rate": 0,
        "maxParticles": 1,
        "loop": false,
        "lifetime": 3,
        "speed": 0,
        "spread": 0,
        "gravity": [
          0,
          0,
          0
        ],
        "startSize": 1,
        "endSize": 1,
        "startOpacity": 1,
        "endOpacity": 1,
        "pixelArt": false,
        "mesh": "assets/models/vfx_dome.glb",
        "material": "materials/vfx_shield.mat.json",
        "startColor": [
          0.15,
          0.65,
          1
        ],
        "expressions": {
          "update": {
            "scale": "vec3(1,1,1)*param.radius*(1+sin(age*6*pi)*0.05)",
            "custom0": "1+sin(age*4*pi)*0.3",
            "custom3": "curve(age,0,0,0.15,1,0.8,1,1,0)"
          }
        }
      }
    }
  ],
  "params": {
    "radius": {
      "default": 1.8,
      "targets": [],
      "min": 0.5,
      "max": 3
    }
  }
}
