{
  "format": "oe.vfx",
  "version": 1,
  "name": "Expression Spiral",
  "description": "Text-only birth placement, spiral motion and material channels; no gameplay transform script.",
  "budget": {
    "maxParticles": 96
  },
  "params": {
    "radius": {
      "default": 1.4,
      "min": 0.1,
      "max": 3,
      "targets": []
    },
    "height": {
      "default": 3,
      "min": 0,
      "max": 6,
      "targets": []
    },
    "tint": {
      "default": [
        0.1,
        0.65,
        1
      ],
      "targets": []
    }
  },
  "emitters": [
    {
      "name": "spiral",
      "emitter": {
        "burst": 48,
        "maxParticles": 96,
        "rate": 0,
        "loop": false,
        "lifetime": 3,
        "speed": 0,
        "gravity": [
          0,
          0,
          0
        ],
        "blend": "add",
        "texture": "assets/textures/glow.png",
        "startSize": 0.3,
        "endSize": 0.3,
        "expressions": {
          "birth": {
            "position": "vec3(0,0,0)",
            "rotation": "vec3(0,0,index*360/max(count,1))",
            "custom0": "random"
          },
          "update": {
            "position": "vec3(cos(age*4*pi+index*2*pi/max(count,1))*param.radius,age*param.height,sin(age*4*pi+index*2*pi/max(count,1))*param.radius)",
            "color": "param.tint",
            "size": "birthSize*(0.7+sin(age*pi)*0.6)",
            "opacity": "curve(age,0,0,0.1,1,0.8,1,1,0)",
            "custom1": "age",
            "custom2": "1-pow(1-age,3)",
            "custom3": "systemTime"
          }
        }
      }
    }
  ]
}
