{
  "format": "oe.vfx",
  "version": 1,
  "name": "Tornado",
  "description": "Phase 5b+ text-only acceptance proof; no gameplay transform script.",
  "budget": {
    "maxParticles": 128
  },
  "emitters": [
    {
      "name": "wind",
      "emitter": {
        "burst": 96,
        "rate": 0,
        "maxParticles": 96,
        "loop": false,
        "lifetime": 4,
        "speed": 0,
        "spread": 0,
        "gravity": [
          0,
          0,
          0
        ],
        "startSize": 0.6,
        "endSize": 1,
        "startOpacity": 1,
        "endOpacity": 1,
        "pixelArt": false,
        "lifetimeVariation": 0.15,
        "texture": "assets/textures/smoke.png",
        "columns": 2,
        "rows": 2,
        "frames": 4,
        "randomFrame": true,
        "startColor": [
          0.4,
          0.5,
          0.7
        ],
        "batching": true,
        "expressions": {
          "birth": {
            "position": "vec3(0,index/max(count,1)*param.height,0)",
            "rotation": "vec3(0,0,random*360)"
          },
          "update": {
            "position": "vec3(cos(age*6*pi+index*0.7)*(0.2+birthPosition.y*0.3),age*param.rise,sin(age*6*pi+index*0.7)*(0.2+birthPosition.y*0.3))",
            "size": "birthSize*(0.5+birthPosition.y*0.25)",
            "opacity": "curve(age,0,0,0.15,0.32,0.8,0.32,1,0)",
            "rotation": "vec3(0,0,age*180)"
          }
        }
      }
    },
    {
      "name": "motes",
      "emitter": {
        "burst": 32,
        "rate": 0,
        "maxParticles": 32,
        "loop": false,
        "lifetime": 4,
        "speed": 0,
        "spread": 0,
        "gravity": [
          0,
          0,
          0
        ],
        "startSize": 0.1,
        "endSize": 1,
        "startOpacity": 1,
        "endOpacity": 1,
        "pixelArt": false,
        "texture": "assets/textures/glow.png",
        "blend": "add",
        "startColor": [
          0.25,
          0.7,
          1
        ],
        "batching": true,
        "expressions": {
          "birth": {
            "position": "vec3(0,index/max(count,1)*param.height,0)"
          },
          "update": {
            "position": "vec3(cos(age*6*pi+index*1.3)*(0.2+birthPosition.y*0.3),age*param.rise,sin(age*6*pi+index*1.3)*(0.2+birthPosition.y*0.3))",
            "opacity": "curve(age,0,0,0.1,1,0.8,1,1,0)"
          }
        }
      }
    }
  ],
  "params": {
    "height": {
      "default": 3.2,
      "targets": [],
      "min": 0.5,
      "max": 5
    },
    "rise": {
      "default": 0.9,
      "targets": [],
      "min": 0,
      "max": 2
    }
  }
}
