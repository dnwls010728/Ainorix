{
  "format": "ownengine.project",
  "version": 1,
  "name": "OnlineRPG",
  "startScene": "scenes/main.scene.json",
  "window": {
    "width": 1280,
    "height": 720,
    "title": "OnlineRPG"
  },
  "network": {
    "mode": "authoritative",
    "transport": "tcp",
    "bind": "127.0.0.1",
    "port": 7778,
    "gameId": "OnlineRPG",
    "maxPlayers": 8,
    "actions": [
      "W",
      "A",
      "S",
      "D",
      "Up",
      "Down",
      "Left",
      "Right",
      "Shift",
      "E"
    ],
    "axes": [
      "LeftX",
      "LeftY"
    ],
    "playerPrefab": "prefabs/player.prefab.json",
    "lateJoin": true,
    "admission": "script",
    "snapshotRate": 20,
    "interpolationFrames": 6,
    "predictionFrames": 32
  }
}
